{
  "name": "haftalik-hayat-karti",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.19.0 <25.0.0"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "0.4.1",
    "@expo-google-fonts/inter": "0.4.2",
    "expo": "~58.0.7",
    "expo-application": "~58.1.0",
    "expo-build-properties": "~58.0.10",
    "expo-constants": "~58.0.10",
    "expo-file-system": "~58.0.8",
    "expo-font": "~58.0.7",
    "expo-linking": "~58.0.11",
    "expo-notifications": "~58.1.2",
    "expo-router": "~58.0.17",
    "expo-sharing": "~58.0.16",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-view-shot": "6.1.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "test": "cross-env TZ=Europe/Istanbul jest",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/__tests__/helpers/"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/__tests__/helpers/css-mock.js"
    }
  }
}
